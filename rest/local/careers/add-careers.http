
@urlBase = {{$dotenv BASE_URL}}
@payloadItem = careers
@apiKey = {{$dotenv API_TOKEN}}
@url = {{urlBase}}/{{payloadItem}}


### FETCH
GET {{url}}
Content-Type: application/json
Authorization: users API-Key {{apiKey}}

###POST1
POST {{url}}
Content-Type: application/json
Authorization: users API-Key {{apiKey}}

{
    "title": "Marketing Coordinator",
    "description": "Assist in the development and execution of marketing strategies to promote our brand and products.",
    "category": 2,
    "work_type": 1,
    "responsibilities": [
        {
            "title": "Coordinate marketing campaigns",
            "sub_title": "Across multiple channels"
        },
        {
            "title": "Monitor campaign performance",
            "sub_title": null
        },
        {
            "title": "Collaborate with creative team",
            "sub_title": "To develop content"
        }
    ],
    "qualifications": [
        {
            "title": "Bachelor's degree in Marketing",
            "sub_title": null
        },
        {
            "title": "1-2 years of experience in marketing",
            "sub_title": null
        }
    ],
    "questions": [
        {
            "careers_questions": 1
        },
        {
            "careers_questions": 2
        }
    ]
}

